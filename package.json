{
  "name": "otelc-dedupe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Finds existing work in opentelemetry-go-compile-instrumentation before you file a duplicate",
  "scripts": {
    "fetch": "node scripts/fetch.mjs",
    "index": "node scripts/index.mjs",
    "eval": "node scripts/eval.mjs",
    "report": "node scripts/report.mjs",
    "all": "npm run fetch && npm run index && npm run eval && npm run report",
    "serve": "node server.mjs",
    "dev": "node server.mjs",
    "judge-eval": "node scripts/judge-eval.mjs",
    "prod-eval": "node scripts/prod-eval.mjs",
    "rules-vs-judge": "node scripts/rules-vs-judge.mjs",
    "selftest": "node scripts/selftest.mjs"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
